# このファイルは見本です。コピーして ".env" という名前で保存し、値を書き換えてください。
# .env は Git に含まれません(秘密情報はここにだけ書く)。

# OpenAI APIキー(ステップ5から必要)
OPENAI_API_KEY=

# 使用するモデル
CHAT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# 保存先(通常は変更不要)
DATA_DIR=data
SQLITE_PATH=data/app.db
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads

# アップロード制限
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=pdf,docx,txt

# ログイン(セッションの有効時間と、HTTPS公開時のCookie設定)
SESSION_HOURS=8
COOKIE_SECURE=false
